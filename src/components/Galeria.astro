---
import { Image } from 'astro:assets';
import aventador from '../assets/images/lambo-forest-aventador.jpg';
import corvette from '../assets/images/corvette-z06-track.jpg';
import porsche from '../assets/images/porsche-row.jpg';
import fleet from '../assets/images/lambo-fleet-formation.jpg';
import track from '../assets/images/track-day-cornering.jpg';
import aerial from '../assets/images/aerial-saoroque.jpg';

// Photos only, no captions on the cards; the alt text still describes each one
const cars = [
  { src: aventador, alt: 'Lamborghini Aventador grafite com os faróis acesos' },
  { src: corvette, alt: 'Corvette Z06 amarelo na pista' },
  { src: porsche, alt: 'Fileira de Porsches estacionados na grama' },
  { src: fleet, alt: 'Frota de Lamborghinis em formação na pista' },
  { src: track, alt: 'Supercarros contornando uma curva no track day do SCA' },
  { src: aerial, alt: 'Encontro do SCA em São Roque, com centenas de carros reunidos' },
];
---
<section class="gal" id="galeria" data-gallery aria-label="Fotos do Super Carros Alphaville">
  <div class="gal__viewport" data-gal-viewport>
    <div class="gal__track" data-gal-track>
      {cars.map((c) => (
        <article class="gal__card" data-gal-card>
          <div class="gal__media">
            <Image
              src={c.src}
              alt={c.alt}
              class="media-cover"
              widths={[480, 760, 1040]}
              sizes="(max-width: 900px) 80vw, 40vw"
              quality={80}
              loading="lazy"
            />
            <div class="gal__dim" aria-hidden="true"></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .gal { position: relative; background: var(--bg); overflow: clip; }
  /* Fallback strip (no pin) needs its own breathing room now there is no heading above it */
  .gal:not(.is-pinned) { padding-top: clamp(3rem, 8vw, 6rem); }

  /* Mobile-first: native horizontal scroll with snap */
  .gal__viewport {
    overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory; scrollbar-width: none;
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .gal__viewport::-webkit-scrollbar { display: none; }
  .gal__track {
    display: flex; align-items: stretch; gap: clamp(1rem, 2vw, 2rem);
    padding-inline: var(--gutter); width: max-content;
  }
  .gal__card {
    scroll-snap-align: center; flex: 0 0 auto;
    position: relative; width: clamp(280px, 82vw, 360px); height: clamp(380px, 62vh, 560px);
    overflow: clip; border: 1px solid var(--line); background: var(--bg-1);
  }
  .gal__media { position: absolute; inset: 0; overflow: clip; }
  .gal__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (hover: hover) {
    .gal__media :global(img) { transition: transform var(--dur-slow) var(--ease-expo); }
    .gal__card:hover .gal__media :global(img) { transform: scale(1.06); }
  }
  /* Opacity veil: the card "lights up" as it reaches centre stage (GSAP scrubs 0.55 → 0).
     Rests at 0 so the native scroll-snap fallback shows every card lit. */
  .gal__dim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: #060e0b; opacity: 0;
  }

  /* Desktop sizes; the base horizontal scroll-snap strip stays as the
     no-JS / reduced-motion / GSAP-failure fallback (cards must stay reachable). */
  @media (min-width: 901px) {
    .gal__card { width: clamp(360px, 34vw, 520px); height: clamp(420px, 62svh, 620px); }

    /* Pinned parade — ONLY when JS actually drives it (.is-pinned) */
    .gal.is-pinned { height: 100svh; min-height: min(640px, 100svh); display: flex; flex-direction: column; }
    .gal.is-pinned .gal__viewport {
      flex: 1; overflow: hidden; scroll-snap-type: none; padding-bottom: 0;
      display: flex; align-items: center;
    }
    .gal.is-pinned .gal__track { height: 74%; align-items: center; }
    .gal.is-pinned .gal__card { height: 100%; scroll-snap-align: none; }
  }

  /* Mobile pinned parade ("O Desfile") — activated by JS via .is-pinned; the
     native scroll-snap above stays as the no-JS / reduced-motion fallback. */
  @media (max-width: 900px) {
    .gal.is-pinned { height: 100svh; display: flex; flex-direction: column; }
    .gal.is-pinned .gal__viewport {
      flex: 1; overflow: hidden; scroll-snap-type: none; padding-bottom: clamp(1.2rem, 4vh, 2rem);
      display: flex; align-items: center;
    }
    .gal.is-pinned .gal__card { scroll-snap-align: none; height: min(58svh, 520px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gal__card { filter: none !important; transform: none !important; }
    .gal__dim { opacity: 0 !important; }
  }
</style>
