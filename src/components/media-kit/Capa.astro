---
import { Image } from 'astro:assets';
import poster from '../../assets/images/sca-country-3-poster.jpg';
import ambient from '../../assets/images/sca-country-3-ambient.jpg';
import { capa, event, reserveCta } from '../../data/media-kit';

const facts = [
  { label: 'Data', value: event.date ?? 'Em breve' },
  { label: 'Local', value: event.venue ?? 'Em breve' },
  { label: 'Acesso', value: event.access },
];
---
<!-- Same .hero__* hooks as the home hero, so motion-gsap plays the curtain intro + scroll exit -->
<section class="hero mk-hero grain" id="top">
  <div class="hero__media" data-parallax="0.16">
    <Image src={ambient} alt="" class="media-cover" widths={[960]} sizes="100vw" loading="eager" quality={70} />
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__exit-scrim" aria-hidden="true"></div>

  <div class="hero__content container container--wide">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow" data-reveal="fade">{capa.eyebrow}</p>

      <h1 class="hero__title">
        {capa.titleLines.map((line, i) => (
          <span class="line-mask"><span style={`--reveal-delay:${140 + i * 120}ms`}>{line}</span></span>
        ))}
      </h1>

      <p class="hero__lead lead" data-reveal style="--reveal-delay:560ms">{capa.lead}</p>

      <div class="hero__actions" data-reveal style="--reveal-delay:680ms">
        <a class="btn hero__cta" href={reserveCta.href} target="_blank" rel="noopener" aria-label={`${reserveCta.label}, falar no WhatsApp (abre em nova aba)`}>
          <span>{reserveCta.label}</span><span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="hero__link" href={capa.ctaSecondary.href}>
          <span>{capa.ctaSecondary.label}</span>
          <span class="hero__link-line" aria-hidden="true"></span>
        </a>
      </div>

      <dl class="mk-facts" data-reveal data-intro style="--reveal-delay:900ms">
        {facts.map((f) => (
          <div class="mk-facts__item">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure class="mk-poster" data-reveal="scale" data-intro style="--reveal-delay:380ms">
      <div class="mk-poster__art">
        <Image
          src={poster}
          alt={capa.posterAlt}
          widths={[480, 760, 1080, 1254]}
          sizes="(max-width: 900px) 92vw, 520px"
          loading="eager"
          quality={84}
        />
      </div>
      <div class="mk-poster__frame" aria-hidden="true"></div>
      <figcaption class="mk-poster__cap">
        <span class="facet" aria-hidden="true"></span>
        <span>Arte oficial · {event.edition}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: clamp(6.5rem, 13vh, 8.5rem);
    padding-bottom: clamp(4rem, 9vh, 6rem);
    overflow: clip;
    isolation: isolate;
  }

  /* Ambient layer: the event art, pre-blurred (no live filter), as a sunset glow */
  .hero__media { position: absolute; inset: -8% 0; will-change: transform; z-index: 0; }
  .hero__media :global(img) { opacity: 0.6; }
  .hero__scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(180deg,
        rgba(6,14,11,0.72) 0%,
        rgba(6,14,11,0.30) 36%,
        rgba(6,14,11,0.62) 72%,
        rgba(6,14,11,1) 100%),
      linear-gradient(90deg,
        rgba(6,14,11,0.94) 0%,
        rgba(6,14,11,0.62) 46%,
        rgba(6,14,11,0.18) 100%);
  }
  .hero__glow {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      radial-gradient(60% 50% at 14% 78%, rgba(43,124,94,0.22), transparent 62%),
      radial-gradient(42% 40% at 78% 40%, rgba(198,161,91,0.10), transparent 70%);
  }
  .hero__exit-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: #040a08; opacity: 0;
  }

  .hero__content {
    position: relative; z-index: 2; width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .hero__eyebrow { margin: 0 0 clamp(1rem, 2vh, 1.5rem); color: var(--champagne); }

  .hero__title {
    margin: 0 0 clamp(1.2rem, 2.4vh, 1.7rem);
    font-weight: 600;
    font-size: clamp(2.1rem, 1rem + 3.6vw, 3.6rem);
    line-height: 1.02;
    text-transform: uppercase;
    word-spacing: 0.1em;   /* tight display tracking swallows the spaces in multi-word caps lines */
    max-width: 17ch;
  }
  .hero__title .line-mask > span { padding-block: 0.05em; }
  .hero__title .line-mask:nth-child(2) > span {
    color: var(--gold);
    font-style: italic;
    font-family: var(--font-serif);
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .hero__lead {
    margin: 0 0 clamp(1.5rem, 2.8vh, 2.1rem);
    max-width: 46ch;
    font-size: clamp(1.05rem, 0.98rem + 0.4vw, 1.3rem);
    line-height: 1.5;
  }

  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(1.1rem, 2.4vw, 2rem); }
  .hero__cta { flex: none; }
  .hero__link {
    position: relative;
    display: inline-flex; align-items: center;
    color: var(--text);
    font-size: var(--fs-small); font-weight: 600;
    letter-spacing: var(--track-label); text-transform: uppercase;
    padding-block: 0.45rem;
    transition: color var(--dur-fast) var(--ease-quad);
  }
  .hero__link-line {
    position: absolute; left: 0; bottom: 0; width: 100%; height: 1px;
    background: var(--line-strong); overflow: hidden;
  }
  .hero__link-line::after {
    content: ""; position: absolute; inset: 0; background: var(--gold);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur-mid) var(--ease-expo);
  }
  .hero__link:hover { color: var(--gold-bright); }
  .hero__link:hover .hero__link-line::after,
  .hero__link:focus-visible .hero__link-line::after { transform: scaleX(1); }

  /* Event facts: instrument-panel row */
  .mk-facts {
    display: grid; grid-template-columns: repeat(3, auto); justify-content: start;
    gap: clamp(1.4rem, 3vw, 3rem);
    margin-top: clamp(2rem, 4.5vh, 3rem); padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .mk-facts dt {
    font-size: 0.66rem; font-weight: 500; letter-spacing: var(--track-label);
    text-transform: uppercase; color: var(--gold);
  }
  .mk-facts dd { margin: 0.5rem 0 0; font-size: 0.95rem; color: var(--text-strong); line-height: 1.35; }

  /* The official art, framed like a print */
  .mk-poster { position: relative; margin: 0 0 2.8rem; justify-self: end; width: min(100%, 520px); }
  .mk-poster__art {
    position: relative; aspect-ratio: 1; overflow: clip;
    box-shadow: 0 44px 90px -44px rgba(0,0,0,0.95), 0 0 0 1px var(--line-gold);
  }
  .mk-poster__art :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* figure box = the art (caption is absolute, below; margin-bottom reserves its room) */
  .mk-poster__frame { position: absolute; inset: -12px; pointer-events: none; border: 1px solid var(--line-gold); }
  .mk-poster__frame::before, .mk-poster__frame::after {
    content: ''; position: absolute; width: 28px; height: 28px; border: 1px solid var(--gold);
  }
  .mk-poster__frame::before { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .mk-poster__frame::after { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
  .mk-poster__cap {
    position: absolute; left: 0; bottom: -2.6rem;
    display: flex; align-items: center; gap: 0.6rem;
    font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-muted);
  }
  .mk-poster__cap .facet { color: var(--gold); }

  @media (max-height: 720px) and (min-width: 901px) {
    .hero__title { font-size: clamp(2rem, 3.2vw, 3.1rem); margin-bottom: 1rem; }
    .hero__lead { margin-bottom: 1.2rem; }
    .mk-poster { width: min(100%, 440px); }
  }

  /* Tablet + phone: art first (the image people already know from the feed), copy below */
  @media (max-width: 900px) {
    .hero { min-height: 0; padding-top: clamp(5.5rem, 14vh, 7rem); }
    .hero__content { grid-template-columns: 1fr; gap: clamp(2.2rem, 7vw, 3rem); }
    .mk-poster { order: -1; justify-self: start; width: min(100%, 460px); }
    .hero__scrim {
      background: linear-gradient(180deg, rgba(6,14,11,0.55) 0%, rgba(6,14,11,0.40) 30%, rgba(6,14,11,0.86) 62%, rgba(6,14,11,1) 100%);
    }
  }
  @media (max-width: 760px) {
    .hero__title { font-size: clamp(2rem, 9.4vw, 2.7rem); max-width: none; }
    .hero__lead { font-size: 1.05rem; }
    .mk-poster__frame { inset: -8px; }
    .mk-facts { grid-template-columns: repeat(2, auto); gap: 1.2rem 2rem; }
    .mk-facts__item:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .hero__actions { flex-direction: column; align-items: stretch; gap: 1.1rem; }
    .hero__actions .hero__cta { width: 100%; justify-content: center; }
    .hero__link { justify-content: center; align-self: stretch; }
  }
</style>

<script>
  // Art + facts join the curtain intro. initHero only drives eyebrow/title/lead/actions,
  // and the GSAP reveal batch skips .hero, so these [data-intro] reveals are fired here.
  const intro = document.querySelectorAll<HTMLElement>('.mk-hero [data-intro]');
  const show = () => intro.forEach((el) => el.classList.add('is-in'));
  if ((window as unknown as { __scaPreloaded?: boolean }).__scaPreloaded) show();
  else window.addEventListener('sca:preloaded', show, { once: true });
</script>
