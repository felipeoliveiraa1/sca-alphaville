---
import { Image, getImage } from 'astro:assets';
import { capa, event, reserveCta } from '../../data/media-kit';
import { resolveImage, widthsFor } from '../../lib/media-kit-images';

const cover = resolveImage(capa.image)!;
const coverMobile = resolveImage(`${capa.image}-mobile`);
const mobileSet = coverMobile
  ? await getImage({ src: coverMobile, widths: widthsFor(coverMobile, [480, 768]), format: 'webp' })
  : undefined;
const facts = [
  { label: 'Onde', value: event.place },
  { label: 'Quando', value: event.date },
  { label: 'Horário', value: event.hours },
];
---
<!-- Same .hero__* hooks as the home hero, so motion-gsap plays the curtain intro + scroll exit -->
<section class="hero mk-cover grain" id="top">
  <div class="hero__media" data-parallax="0.16">
    <picture>
      {mobileSet && <source media="(max-width: 760px)" srcset={mobileSet.srcSet.attribute} sizes="100vw" />}
      <Image
        src={cover}
        alt={capa.imageAlt}
        class="media-cover hero__img"
        widths={widthsFor(cover)}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={82}
      />
    </picture>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__exit-scrim" aria-hidden="true"></div>

  <div class="hero__content container container--wide">
    <p class="eyebrow hero__eyebrow" data-reveal="fade">{capa.eyebrow}</p>

    <h1 class="hero__title">
      {capa.titleLines.map((line, i) => (
        <span class="line-mask"><span style={`--reveal-delay:${140 + i * 120}ms`}>{line}</span></span>
      ))}
    </h1>

    <dl class="hero__lead mk-facts" data-reveal style="--reveal-delay:560ms">
      {facts.map((f) => (
        <div class="mk-facts__item">
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>

    <div class="hero__actions" data-reveal style="--reveal-delay:680ms">
      <a class="btn hero__cta" href={reserveCta.href} target="_blank" rel="noopener" aria-label={`${reserveCta.label}, falar no WhatsApp (abre em nova aba)`}>
        <span>{reserveCta.label}</span><span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="hero__link" href={capa.ctaSecondary.href}>
        <span>{capa.ctaSecondary.label}</span>
        <span class="hero__link-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex; align-items: flex-end;
    padding-top: clamp(6.5rem, 13vh, 8.5rem);
    padding-bottom: clamp(3rem, 8vh, 5.5rem);
    overflow: clip; isolation: isolate;
  }

  .hero__media { position: absolute; inset: -8% 0; will-change: transform; z-index: 0; }
  .hero__img { object-position: center 52%; }
  .hero__scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(180deg,
        rgba(6,14,11,0.62) 0%,
        rgba(6,14,11,0.06) 26%,
        rgba(6,14,11,0.22) 50%,
        rgba(6,14,11,0.90) 80%,
        rgba(6,14,11,1) 100%),
      linear-gradient(90deg,
        rgba(6,14,11,0.78) 0%,
        rgba(6,14,11,0.30) 50%,
        rgba(6,14,11,0) 78%);
  }
  .hero__glow {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(60% 50% at 12% 88%, rgba(43,124,94,0.22), transparent 62%);
  }
  .hero__exit-scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: #040a08; opacity: 0; }

  .hero__content { position: relative; z-index: 2; width: 100%; }
  .hero__eyebrow { margin: 0 0 clamp(1rem, 2vh, 1.4rem); color: var(--champagne); }

  /* The cover line: SCA COUNTRY monumental, the edition in gold serif */
  .hero__title {
    margin: 0 0 clamp(1.6rem, 3.4vh, 2.4rem);
    font-weight: 600; text-transform: uppercase;
    font-size: clamp(2.9rem, 0.6rem + 8.4vw, 9rem);
    line-height: 0.92; letter-spacing: -0.04em; word-spacing: 0.08em;
  }
  .hero__title .line-mask > span { padding-block: 0.04em; }
  .hero__title .line-mask:nth-child(2) > span {
    color: var(--gold); font-family: var(--font-serif); font-style: italic; font-weight: 400;
    text-transform: none; letter-spacing: -0.015em;
    font-size: 0.62em; line-height: 1.15;
  }

  /* Where · when · hours — big enough to read from across the room */
  .mk-facts {
    display: flex; flex-wrap: wrap; gap: clamp(1.2rem, 3vw, 3.4rem);
    padding-top: 1.3rem; border-top: 1px solid var(--line-strong);
    margin-bottom: clamp(1.8rem, 3.6vh, 2.6rem); max-width: 70rem;
  }
  .mk-facts dt {
    font-size: 0.68rem; font-weight: 500; letter-spacing: var(--track-label);
    text-transform: uppercase; color: var(--gold);
  }
  .mk-facts dd {
    margin: 0.45rem 0 0; color: var(--text-strong); line-height: 1.25;
    font-family: var(--font-display); font-weight: 500; letter-spacing: -0.01em;
    font-size: clamp(1.15rem, 0.9rem + 0.9vw, 1.65rem);
  }

  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(1.1rem, 2.4vw, 2rem); }
  .hero__cta { flex: none; }
  .hero__link {
    position: relative; display: inline-flex; align-items: center;
    color: var(--text); font-size: var(--fs-small); font-weight: 600;
    letter-spacing: var(--track-label); text-transform: uppercase;
    padding-block: 0.45rem; transition: color var(--dur-fast) var(--ease-quad);
  }
  .hero__link-line { position: absolute; left: 0; bottom: 0; width: 100%; height: 1px; background: var(--line-strong); overflow: hidden; }
  .hero__link-line::after {
    content: ""; position: absolute; inset: 0; background: var(--gold);
    transform: scaleX(0); transform-origin: left; transition: transform var(--dur-mid) var(--ease-expo);
  }
  .hero__link:hover { color: var(--gold-bright); }
  .hero__link:hover .hero__link-line::after, .hero__link:focus-visible .hero__link-line::after { transform: scaleX(1); }

  @media (max-width: 760px) {
    /* the copy covers most of a phone's height: darken from a third down, keep the track + tents up top */
    .hero__scrim {
      background: linear-gradient(180deg, rgba(6,14,11,0.55) 0%, rgba(6,14,11,0.1) 16%, rgba(6,14,11,0.68) 34%, rgba(6,14,11,0.9) 50%, rgba(6,14,11,0.98) 100%);
    }
    .mk-facts { flex-direction: column; gap: 0.9rem; }
  }
  @media (max-width: 480px) {
    .hero__actions { flex-direction: column; align-items: stretch; gap: 1.1rem; }
    .hero__actions .hero__cta { width: 100%; justify-content: center; }
    .hero__link { justify-content: center; align-self: stretch; }
  }
</style>
