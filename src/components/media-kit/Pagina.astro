---
/* One full-screen "PDF page" of the media kit: big art, sector label, page counter. */
import { Image, getImage } from 'astro:assets';
import type { Pagina } from '../../data/media-kit';
import { resolveImage, widthsFor } from '../../lib/media-kit-images';

interface Props {
  page: Pagina;
  n: number;
  total: number;
  /** statement: long mixed-case title · plain: no art, content-led page (index, stand tiers) */
  variant?: 'default' | 'statement' | 'plain';
  /** outline numeral behind a page that has no art yet (its sector number) */
  ghost?: string;
}
const { page, n, total, variant = 'default', ghost } = Astro.props;
const img = variant === 'plain' ? undefined : resolveImage(page.image, page.fallback);
// a portrait cut for phones is picked up by name: "<image>-mobile"
const imgMobile = img ? resolveImage(page.imageMobile ?? (page.image && `${page.image}-mobile`)) : undefined;
const mobileSet = imgMobile
  ? await getImage({ src: imgMobile, widths: widthsFor(imgMobile, [480, 768]), format: 'webp' })
  : undefined;
const pad = (x: number) => String(x).padStart(2, '0');
// one very long word ("ESTACIONAMENTO") needs a smaller title on phones or it gets clipped
const longWord = Math.max(...page.title.split(/\s+/).map((w) => w.length)) >= 12;
---
<section
  class:list={[
    'pg', `pg--${variant}`, img ? 'pg--art' : variant !== 'plain' && 'pg--type',
    page.copyAt === 'top' && 'pg--top', page.video && 'pg--video',
  ]}
  id={page.id}
>
  {variant !== 'plain' && (
    <div class="pg__media" data-parallax="0.08" aria-hidden={img ? undefined : 'true'}>
      {img ? (
        <picture>
          {mobileSet && <source media="(max-width: 760px)" srcset={mobileSet.srcSet.attribute} sizes="100vw" />}
          <Image
            src={img}
            alt={page.imageAlt ?? ''}
            class="media-cover"
            widths={widthsFor(img)}
            sizes="100vw"
            quality={78}
            loading="lazy"
            style={page.position ? `object-position:${page.position}` : undefined}
          />
        </picture>
      ) : (
        ghost && <span class="pg__ghost">{ghost}</span>
      )}
    </div>
  )}
  <div class="pg__scrim" aria-hidden="true"></div>

  <div class="pg__bar container container--wide">
    <p class="pg__label"><span class="facet" aria-hidden="true"></span>{page.label}</p>
    <span class="pg__count" aria-hidden="true">{pad(n)}<i>/</i>{pad(total)}</span>
  </div>

  <div class="pg__body container container--wide">
    <div class="pg__copy">
      {page.badge && <p class="pg__badge" data-reveal="fade">{page.badge}</p>}
      {page.mega && <p class:list={['pg__mega', page.mega.length > 6 && 'pg__mega--long']} data-reveal>{page.mega}</p>}
      <h2 class:list={['pg__title', longWord && 'pg__title--long']} data-reveal data-split>{page.title}</h2>
      {page.accent && <p class="pg__accent" data-reveal style="--reveal-delay:100ms">{page.accent}</p>}
      {page.lead && <p class="pg__lead" data-reveal style="--reveal-delay:160ms">{page.lead}</p>}
      {page.chips && (
        <ul class="pg__chips">
          {page.chips.map((c, i) => <li data-reveal style={`--reveal-delay:${220 + i * 60}ms`}>{c}</li>)}
        </ul>
      )}
      {page.cta && (
        <div class="pg__cta" data-reveal style="--reveal-delay:220ms">
          <a class="btn" href={page.cta.href}>
            <span>{page.cta.label}</span><span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )}
    </div>
    {page.video && (
      <figure class="pg__video" data-mk-video>
        <video class="pg__video-el" muted loop playsinline preload="none" poster={page.video.poster} aria-label={page.video.title}>
          <source data-src={page.video.src} type="video/mp4" />
        </video>
        <button class="pg__sound" type="button" data-mk-sound aria-pressed="false">
          <span class="pg__sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="pg__sound-label">Ativar som</span>
        </button>
      </figure>
    )}
    <slot />
  </div>
</section>

<style>
  .pg {
    position: relative; overflow: clip; isolation: isolate;
    min-height: 100svh;
    display: flex; flex-direction: column;
  }

  /* ---- Art layer ---- */
  .pg__media { position: absolute; inset: -8% 0; z-index: -2; will-change: transform; }
  .pg__scrim { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .pg--art .pg__scrim {
    background:
      linear-gradient(180deg, rgba(6,14,11,0.66) 0%, rgba(6,14,11,0) 24%, rgba(6,14,11,0) 40%, rgba(6,14,11,0.84) 74%, rgba(6,14,11,0.98) 100%),
      linear-gradient(90deg, rgba(6,14,11,0.72) 0%, rgba(6,14,11,0.18) 55%, rgba(6,14,11,0) 80%);
  }

  /* No art yet: a typographic page (emerald depth + the sector number in gold outline) */
  .pg--type .pg__media {
    background:
      radial-gradient(60% 70% at 80% 32%, rgba(43,124,94,0.30), transparent 66%),
      radial-gradient(45% 45% at 12% 92%, rgba(198,161,91,0.10), transparent 70%),
      linear-gradient(180deg, var(--bg-1), var(--bg));
  }
  .pg--type .pg__scrim { background: linear-gradient(180deg, transparent 55%, rgba(6,14,11,0.85)); }
  .pg__ghost {
    position: absolute; right: -0.06em; top: 50%; transform: translateY(-58%);
    font-family: var(--font-display); font-weight: 600; text-transform: uppercase;
    font-size: clamp(9rem, 2rem + 30vw, 34rem); line-height: 0.8; letter-spacing: -0.05em;
    color: transparent; -webkit-text-stroke: 1px rgba(198,161,91,0.30);
    white-space: nowrap; user-select: none;
  }

  .pg--plain {
    background:
      radial-gradient(55% 45% at 50% 0%, rgba(43,124,94,0.14), transparent 70%),
      radial-gradient(40% 30% at 90% 100%, rgba(198,161,91,0.06), transparent 70%);
    border-top: 1px solid var(--line);
  }

  /* ---- Page chrome: sector label + PDF-style counter ---- */
  .pg__bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-top: clamp(6.2rem, 13vh, 8rem);
  }
  .pg__label {
    display: inline-flex; align-items: center; gap: 0.8rem;
    font-size: var(--fs-eyebrow); font-weight: 500; letter-spacing: var(--track-label);
    text-transform: uppercase; color: var(--gold-bright);
  }
  .pg__label .facet { color: var(--gold); flex: none; }
  .pg__count {
    font-family: var(--font-display); font-weight: 500; font-size: 0.95rem; letter-spacing: 0.06em;
    color: var(--text); font-variant-numeric: tabular-nums;
  }
  .pg__count i { font-style: normal; color: var(--text-dim); margin-inline: 0.4em; }

  /* ---- Copy: anchored low, like a cover line ---- */
  .pg__body {
    flex: 1; display: flex; flex-direction: column; justify-content: flex-end;
    padding-top: clamp(2rem, 6vh, 4rem); padding-bottom: clamp(3rem, 9vh, 6.5rem);
  }
  .pg--plain .pg__body, .pg--top .pg__body { justify-content: flex-start; }
  .pg--art.pg--top .pg__scrim {
    background:
      linear-gradient(180deg, rgba(6,14,11,0.94) 0%, rgba(6,14,11,0.78) 34%, rgba(6,14,11,0) 62%, rgba(6,14,11,0.4) 100%),
      linear-gradient(90deg, rgba(6,14,11,0.55) 0%, rgba(6,14,11,0) 60%);
  }
  .pg__copy { max-width: 60rem; }

  .pg__badge {
    display: inline-block; margin-bottom: 1.4rem;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    background: var(--gold-grad); color: #1a1407; padding: 0.55em 1.1em;
  }
  .pg__mega {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(5rem, 1.5rem + 14vw, 15rem); line-height: 0.82; letter-spacing: -0.05em;
    background: var(--gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
    margin-bottom: 0.12em; padding-right: 0.05em;
  }
  /* a word, not a number ("Ecossistema SCA"): same gold monument, sized to fit */
  .pg__mega--long { font-size: clamp(2.8rem, 1rem + 7vw, 8rem); line-height: 0.92; letter-spacing: -0.04em; word-spacing: 0.14em; margin-bottom: 0.3em; }
  .pg__title {
    font-weight: 600; text-transform: uppercase;
    font-size: clamp(2.6rem, 0.8rem + 6vw, 7rem); line-height: 0.94; letter-spacing: -0.035em;
    word-spacing: 0.08em;
    max-width: 14ch;
  }
  .pg--statement .pg__title, .pg--plain .pg__title {
    text-transform: none; letter-spacing: -0.025em; word-spacing: 0.06em;
    font-size: clamp(2rem, 0.9rem + 3.6vw, 4.8rem); line-height: 1.04; max-width: 21ch;
  }
  /* statement page: the gold headline ("Ecossistema SCA") may use the full width; the
     sentence under it steps down so headline + sentence + figures fit one screen */
  .pg--statement .pg__copy { max-width: none; }
  .pg--statement .pg__title { font-size: clamp(1.9rem, 0.9rem + 3vw, 4.2rem); }
  .pg__accent {
    margin-top: 0.7rem;
    font-family: var(--font-serif); font-style: italic; color: var(--gold);
    font-size: clamp(1.5rem, 0.9rem + 2.2vw, 3rem); line-height: 1.1; letter-spacing: -0.01em;
  }
  .pg__lead {
    margin-top: 1.4rem; max-width: 46ch;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.4rem); line-height: 1.5; color: var(--text);
    text-wrap: pretty;
  }
  .pg__chips { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.8rem; max-width: 52rem; }
  .pg__chips li {
    font-size: 0.74rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
    padding: 0.6em 1em; color: var(--text);
    border: 1px solid rgba(236,233,225,0.24); background: rgba(6,14,11,0.55);
  }
  .pg__cta { margin-top: 2.2rem; }

  /* ---- Video page (DJ): a framed 9:16 reel beside the copy, over the stage art ---- */
  .pg--video .pg__body { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: clamp(2rem, 5vw, 5rem); }
  .pg--video .pg__copy { flex: 1 1 auto; min-width: 0; }
  .pg__video {
    position: relative; flex: none; align-self: center; margin: 0;
    height: min(68svh, 660px); aspect-ratio: 9 / 16;
    background: #000; border: 1px solid var(--line-gold);
    box-shadow: 0 40px 90px -40px rgba(0,0,0,0.9);
  }
  .pg__video::before, .pg__video::after {
    content: ''; position: absolute; z-index: 1; width: 26px; height: 26px;
    border: 1px solid var(--gold); pointer-events: none;
  }
  .pg__video::before { top: -7px; left: -7px; border-right: 0; border-bottom: 0; }
  .pg__video::after { bottom: -7px; right: -7px; border-left: 0; border-top: 0; }
  .pg__video-el { width: 100%; height: 100%; object-fit: cover; }

  /* sound pill, in the voice of the site's ambient toggle */
  .pg__sound {
    position: absolute; left: 50%; bottom: 1rem; translate: -50% 0; z-index: 2;
    display: inline-flex; align-items: center; gap: 0.6rem; white-space: nowrap;
    padding: 0.6rem 1rem 0.6rem 0.85rem; border-radius: 999px;
    background: rgba(6,14,11,0.78); border: 1px solid var(--line-strong); color: var(--text);
    font-size: 0.66rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .pg__sound:hover { border-color: var(--line-gold); color: var(--text-strong); }
  .pg__sound.is-on { border-color: var(--line-gold); color: var(--gold-bright); }
  .pg__sound-bars { display: inline-flex; align-items: flex-end; gap: 2px; height: 14px; }
  .pg__sound-bars i { width: 2px; height: 4px; border-radius: 1px; background: var(--gold); }
  .pg__sound.is-on .pg__sound-bars i { animation: pg-eq 900ms var(--ease-inout) infinite; }
  .pg__sound.is-on .pg__sound-bars i:nth-child(2) { animation-delay: 0.15s; }
  .pg__sound.is-on .pg__sound-bars i:nth-child(3) { animation-delay: 0.3s; }
  .pg__sound.is-on .pg__sound-bars i:nth-child(4) { animation-delay: 0.45s; }
  @keyframes pg-eq { 0%, 100% { height: 4px; } 50% { height: 14px; } }
  @media (prefers-reduced-motion: reduce) {
    .pg__sound.is-on .pg__sound-bars i { animation: none; height: 9px; }
  }

  @media (max-width: 760px) {
    .pg__bar { padding-top: 5.4rem; }
    .pg__label { font-size: 0.68rem; letter-spacing: 0.18em; }
    .pg__count { font-size: 0.82rem; }
    .pg__title { font-size: clamp(2.3rem, 11vw, 3.6rem); max-width: none; }
    .pg__title--long { font-size: clamp(1.6rem, 8.4vw, 3.6rem); }
    .pg__mega { font-size: clamp(4.6rem, 27vw, 8rem); }
    .pg__mega.pg__mega--long { font-size: clamp(2.6rem, 11.5vw, 4rem); }
    .pg--art .pg__scrim {
      background: linear-gradient(180deg, rgba(6,14,11,0.7) 0%, rgba(6,14,11,0) 22%, rgba(6,14,11,0.1) 42%, rgba(6,14,11,0.9) 72%, rgba(6,14,11,0.98) 100%);
    }
    .pg__ghost { font-size: clamp(9rem, 62vw, 20rem); top: 38%; }

    /* Video page on phones: the reel fills the screen (Reels-style) behind the copy.
       It carries its own scrim so the sound pill stays above the shading. */
    .pg--video .pg__media { display: none; }
    .pg--video .pg__bar, .pg--video .pg__copy { position: relative; z-index: 1; }
    .pg--video .pg__body { flex-direction: column; align-items: stretch; justify-content: flex-end; }
    .pg--video .pg__copy { flex: 0 0 auto; }  /* stay a bottom block, don't grow over the reel */
    /* stretch to the insets: the desktop align-self: center would shrink it to the video's own size */
    .pg__video { position: absolute; inset: 0; z-index: 0; align-self: stretch; height: auto; aspect-ratio: auto; border: 0; box-shadow: none; }
    .pg__video::before {
      inset: 0; width: auto; height: auto; border: 0;
      background: linear-gradient(180deg, rgba(6,14,11,0.6) 0%, rgba(6,14,11,0) 20%, rgba(6,14,11,0.05) 44%, rgba(6,14,11,0.88) 72%, rgba(6,14,11,0.98) 100%);
    }
    .pg__video::after { display: none; }
    .pg__sound { left: auto; right: var(--gutter); top: 7.6rem; bottom: auto; translate: none; }
  }
</style>

<script>
  // Copy sits low on a full-screen page, where per-element triggers ('top 88%') may never
  // fire if the reader stops with the page in frame: reveal a page's copy together once
  // a third of it is on screen.
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
      io.unobserve(e.target);
    }),
    { threshold: 0.35 },
  );
  document.querySelectorAll('.pg').forEach((pg) => io.observe(pg));

  // Video page: the reel loads only as it approaches, plays muted while in view (like a
  // feed) and "Ativar som" borrows the speakers from the ambient track (see initAudio in
  // motion.ts, which listens for sca:media-sound and answers with sca:ambient-on).
  document.querySelectorAll<HTMLElement>('[data-mk-video]').forEach((box) => {
    const video = box.querySelector('video');
    const btn = box.querySelector<HTMLButtonElement>('[data-mk-sound]');
    const label = btn?.querySelector('.pg__sound-label');
    if (!video || !btn || !label) return;
    // no autoplay or preloading under reduced motion / data saver: the poster stays until asked
    const quiet =
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      (navigator as unknown as { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let loaded = false;
    let inView = false;

    const load = () => {
      if (loaded) return;
      loaded = true;
      video.querySelectorAll('source').forEach((s) => { if (s.dataset.src) s.src = s.dataset.src; });
      video.load();
    };
    const setSound = (on: boolean) => {
      video.muted = !on;
      btn.classList.toggle('is-on', on);
      btn.setAttribute('aria-pressed', String(on));
      label.textContent = on ? 'Som ligado' : 'Ativar som';
      window.dispatchEvent(new CustomEvent('sca:media-sound', { detail: { on } }));
    };

    btn.addEventListener('click', () => {
      if (video.muted || video.paused) {
        load();
        setSound(true);
        video.play().catch(() => setSound(false));
      } else {
        setSound(false);
      }
    });
    // the ambient toggle was pressed while the reel had the sound: hand it back
    window.addEventListener('sca:ambient-on', () => { if (!video.muted) setSound(false); });

    if (!quiet) {
      new IntersectionObserver((entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) { load(); obs.disconnect(); }
      }, { rootMargin: '600px 0px' }).observe(box);
    }
    new IntersectionObserver((entries) => entries.forEach((e) => {
      inView = e.isIntersecting;
      if (inView) {
        // load() first: a load() that lands after play() resets the element to paused
        if (!quiet) { load(); video.play().catch(() => {}); }
      } else {
        // leaving the page: stop, and give the sound back
        if (!video.muted) setSound(false);
        video.pause();
      }
    }), { threshold: 0.4 }).observe(box);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
      // back on the tab: resume the feed loop, or the reel the visitor chose to hear
      else if (inView && loaded && (!quiet || !video.muted)) video.play().catch(() => {});
    });
  });
</script>
