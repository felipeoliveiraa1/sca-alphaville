---
import { Image } from 'astro:assets';
import formation from '../../assets/images/fleet-formation-saoroque.jpg';
import { reserva } from '../../data/media-kit';
---
<section class="mk-res section" id="reserva">
  <div class="mk-res__bg" aria-hidden="true">
    <div class="mk-res__bg-inner" data-parallax="0.08">
      <Image src={formation} alt="" class="media-cover" widths={[768, 1280, 1440]} sizes="100vw" quality={70} loading="lazy" />
    </div>
  </div>

  <div class="container container--wide">
    <div class="mk-res__head">
      <p class="eyebrow" data-reveal="fade">{reserva.eyebrow}</p>
      <h2 class="mk-res__title" data-reveal data-split>{reserva.title}</h2>
    </div>

    <ol class="mk-res__steps" data-stagger="120">
      {reserva.steps.map((s, i) => (
        <li class="mk-res__step">
          <span class="mk-res__num" aria-hidden="true">0{i + 1}</span>
          <span class="mk-res__node" aria-hidden="true"><span class="facet"></span></span>
          <h3 class="mk-res__name">{s.title}</h3>
          <p class="mk-res__body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .mk-res { position: relative; overflow: clip; }
  .mk-res__bg { position: absolute; inset: 0; z-index: 0; overflow: clip; }
  .mk-res__bg-inner { position: absolute; inset: -10% 0; will-change: transform; }
  .mk-res__bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(6,14,11,1) 0%, rgba(6,14,11,0.84) 30%, rgba(6,14,11,0.84) 70%, rgba(6,14,11,1) 100%);
  }
  .mk-res .container { position: relative; z-index: 1; }

  .mk-res__head { max-width: 30ch; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .mk-res__title { font-size: var(--fs-h2); margin-top: 1.4rem; line-height: 1.05; }

  /* A start line: four stops joined by one gold hairline */
  .mk-res__steps {
    --num-h: clamp(2.6rem, 4.6vw, 3.8rem);
    position: relative; list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.4rem, 3vw, 3rem);
  }
  /* runs through the centre of the facet nodes (numeral + node margin + half node) */
  .mk-res__steps::before {
    content: ''; position: absolute; left: 0; right: 0; top: calc(var(--num-h) + 1.1rem + 0.5rem);
    height: 1px; background: linear-gradient(90deg, var(--gold), var(--line-gold) 70%, transparent);
  }
  .mk-res__step { position: relative; }
  .mk-res__num {
    display: block; height: var(--num-h);
    font-family: var(--font-display); font-weight: 600; line-height: 1;
    font-size: var(--num-h); letter-spacing: -0.04em;
    background: var(--gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .mk-res__node {
    position: relative; z-index: 1;
    display: grid; place-items: center; width: 1rem; height: 1rem; margin-top: 1.1rem;
    background: var(--bg);
  }
  .mk-res__node .facet { color: var(--gold); }
  .mk-res__name { font-size: var(--fs-h4); margin-top: 1.4rem; }
  .mk-res__body { margin-top: 0.7rem; color: var(--text-muted); font-size: 0.98rem; line-height: 1.55; max-width: 30ch; }

  /* Phones/tablets: the line runs down instead of across */
  @media (max-width: 900px) {
    .mk-res__steps { grid-template-columns: 1fr; gap: 2.2rem; padding-left: 2.4rem; }
    .mk-res__steps::before {
      left: 0.5rem; right: auto; top: 0.6rem; bottom: 0.6rem; width: 1px; height: auto;
      background: linear-gradient(180deg, var(--gold), var(--line-gold) 70%, transparent);
    }
    .mk-res__node { position: absolute; left: -2.4rem; top: 0.35rem; margin: 0; }
    .mk-res__num { height: auto; font-size: 0.85rem; letter-spacing: 0.1em; font-weight: 500; }
    .mk-res__name { margin-top: 0.5rem; }
  }
</style>
