---
import { Image } from 'astro:assets';
import { about, reach } from '../../data/site';
import { sobre } from '../../data/media-kit';

import aerial from '../../assets/images/aerial-saoroque.jpg';
import dreamCar from '../../assets/images/dream-car-event.webp';
import trackday from '../../assets/images/track-day-cornering.jpg';

const imageMap: Record<string, ImageMetadata> = {
  'aerial-saoroque': aerial,
  'dream-car-event': dreamCar,
  'track-day-cornering': trackday,
};
---
<section class="mk-sca section" id="sca">
  <div class="container container--wide">
    <div class="mk-sca__grid">
      <div>
        <p class="eyebrow" data-reveal="fade">{sobre.eyebrow}</p>
        <h2 class="mk-sca__title" data-reveal data-split>{sobre.title}</h2>
      </div>
      <div class="mk-sca__body" data-stagger="120">
        {about.body.map((p) => <p class="mk-sca__p">{p}</p>)}
      </div>
    </div>

    <!-- reach__stat / reach__numline: the hooks motion-gsap scrubs counters by on mobile -->
    <div class="mk-sca__stats">
      {reach.stats.map((s) => (
        <div class="reach__stat" data-reveal>
          <div class="reach__numline">
            {s.prefix && <span class="mk-sca__affix">{s.prefix}</span>}
            <span class="mk-sca__num" data-count={s.value}>0</span>
            {s.suffix && <span class="mk-sca__affix">{s.suffix}</span>}
          </div>
          <p class="mk-sca__label">{s.label}</p>
          <p class="mk-sca__note">{s.note}</p>
        </div>
      ))}
    </div>

    <div class="mk-sca__gallery" data-stagger="120">
      {sobre.gallery.map((g) => (
        <figure class="mk-sca__shot">
          <Image
            src={imageMap[g.image]}
            alt={g.alt}
            class="media-cover"
            widths={[480, 800, 1200]}
            sizes="(max-width: 760px) 100vw, 33vw"
            quality={76}
            loading="lazy"
          />
          <figcaption class="mk-sca__cap">
            <span class="facet" aria-hidden="true"></span>
            <span>{g.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .mk-sca__grid {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 6vw, 6rem); align-items: start;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .mk-sca__title { font-size: var(--fs-h2); margin-top: 1.4rem; line-height: 1.05; max-width: 16ch; }
  .mk-sca__body { padding-top: 0.4rem; }
  .mk-sca__p { color: var(--text-muted); font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.25rem); line-height: 1.6; }
  .mk-sca__p + .mk-sca__p { margin-top: 1.2rem; }

  .mk-sca__stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .reach__stat {
    padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 2vw, 2rem) 0 0;
    border-right: 1px solid var(--line);
  }
  .reach__stat + .reach__stat { padding-left: clamp(1rem, 2vw, 2rem); }
  .reach__stat:last-child { border-right: 0; }
  .reach__numline { display: flex; align-items: flex-start; line-height: 0.9; }
  .mk-sca__num {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2.8rem, 7vw, 5.6rem); letter-spacing: -0.045em;
    background: var(--gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .mk-sca__affix {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.4rem, 3.2vw, 2.4rem); color: var(--gold); letter-spacing: -0.02em;
    padding-top: 0.15em;
  }
  .mk-sca__label { margin-top: 1rem; font-size: 1.05rem; color: var(--text-strong); font-weight: 500; letter-spacing: -0.01em; }
  .mk-sca__note { margin-top: 0.4rem; font-size: 0.85rem; color: var(--text-dim); line-height: 1.45; max-width: 24ch; }

  .mk-sca__gallery {
    display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: clamp(0.8rem, 1.6vw, 1.4rem);
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }
  .mk-sca__shot { position: relative; margin: 0; aspect-ratio: 4 / 3; overflow: clip; border: 1px solid var(--line); }
  .mk-sca__shot:first-child { aspect-ratio: auto; }
  .mk-sca__shot :global(img) { transition: transform var(--dur-slow) var(--ease-expo); }
  @media (hover: hover) {
    .mk-sca__shot:hover :global(img) { transform: scale(1.04); }
  }
  .mk-sca__shot::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, transparent 55%, rgba(6,14,11,0.85));
  }
  .mk-sca__cap {
    position: absolute; left: 1rem; bottom: 1rem; z-index: 1;
    display: flex; align-items: center; gap: 0.6rem;
    font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text);
  }
  .mk-sca__cap .facet { color: var(--gold); }

  @media (max-width: 1180px) {
    .mk-sca__stats { grid-template-columns: 1fr 1fr; }
    .reach__stat { border-bottom: 1px solid var(--line); padding-bottom: 2rem; }
    .reach__stat:nth-child(2n) { border-right: 0; }
    .reach__stat:nth-child(2n + 1) { padding-left: 0; }
    .reach__stat:nth-last-child(-n + 2) { border-bottom: 0; }
  }
  @media (max-width: 900px) {
    .mk-sca__grid { grid-template-columns: 1fr; gap: 1.6rem; }
  }
  @media (max-width: 760px) {
    .mk-sca__gallery { grid-template-columns: 1fr 1fr; }
    .mk-sca__shot:first-child { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
  }
  @media (max-width: 480px) {
    .mk-sca__stats { grid-template-columns: 1fr; }
    .reach__stat { border-right: 0; }
    .reach__stat + .reach__stat { padding-left: 0; }
    .reach__stat:not(:last-child) { border-bottom: 1px solid var(--line); }
  }
</style>
