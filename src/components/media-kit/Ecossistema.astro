---
import Pagina from './Pagina.astro';
import { ecossistema } from '../../data/media-kit';

interface Props { n: number; total: number; }
const { n, total } = Astro.props;
const ptBR = (x: number) => x.toLocaleString('pt-BR');
---
<Pagina page={ecossistema.page} n={n} total={total} variant="statement">
  <!-- In the copy column, under the statement. Static figures on purpose: the site's
       scrubbed counters only land once the stat scrolls to mid-screen. -->
  <div class="eco-stats" slot="copy">
    {ecossistema.stats.map((s, i) => (
      <div class="eco-stats__item" data-reveal style={`--reveal-delay:${260 + i * 90}ms`}>
        <div class="eco-stats__numline">
          {s.prefix && <span class="eco-stats__affix">{s.prefix}</span>}
          <span class="eco-stats__num">{ptBR(s.value)}</span>
        </div>
        <p class="eco-stats__label">{s.label}</p>
      </div>
    ))}
  </div>
</Pagina>

<style>
  .eco-stats {
    /* "+3.000" needs the most room */
    display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 0.7fr) minmax(0, 1.45fr);
    margin-top: clamp(1.8rem, 4.5vh, 3rem);
    border-top: 1px solid var(--line-strong);
  }
  .eco-stats__item { padding: clamp(1.1rem, 2.6vh, 1.6rem) clamp(0.8rem, 1.6vw, 1.6rem) 0 0; }
  .eco-stats__item + .eco-stats__item { padding-left: clamp(0.8rem, 1.6vw, 1.6rem); border-left: 1px solid var(--line-strong); }
  .eco-stats__numline { display: flex; align-items: flex-start; line-height: 0.9; }
  .eco-stats__num {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2.2rem, 0.8rem + 2.7vw, 4.4rem); letter-spacing: -0.045em;
    background: var(--gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .eco-stats__affix {
    font-family: var(--font-display); font-weight: 500; color: var(--gold);
    font-size: clamp(1.1rem, 0.6rem + 1.2vw, 2.1rem); padding-top: 0.12em;
  }
  .eco-stats__label {
    margin-top: 0.8rem; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text);
  }

  @media (max-width: 560px) {
    .eco-stats__item { padding-right: 0.6rem; }
    .eco-stats__item + .eco-stats__item { padding-left: 0.8rem; }
    .eco-stats__num { font-size: 2.1rem; }
    .eco-stats__affix { font-size: 1.1rem; }
    .eco-stats__label { font-size: 0.66rem; letter-spacing: 0.12em; }
  }
</style>
