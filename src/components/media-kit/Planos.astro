---
import Pagina from './Pagina.astro';
import { planos, event, waMessage } from '../../data/media-kit';

interface Props { n: number; total: number; }
const { n, total } = Astro.props;

// Floor plans share one scale: every footprint is drawn inside the largest stand's grid.
const maxW = Math.max(...planos.tiers.map((t) => t.width));
const maxD = Math.max(...planos.tiers.map((t) => t.depth));
const m2 = (x: number) => x.toLocaleString('pt-BR');
---
<Pagina page={planos.page} n={n} total={total} variant="plain">
  <div class="tiers" data-stagger="140">
    {planos.tiers.map((t) => (
      <article class={`tier ${t.recommended ? 'is-featured' : ''}`}>
        {t.recommended && <span class="tier__badge">Recomendado</span>}
        <p class="tier__kicker">Stand</p>
        <h3 class="tier__name">{t.name}</h3>

        <figure class="tier__plan">
          <svg viewBox={`0 0 ${maxW} ${maxD}`} aria-hidden="true" focusable="false">
            {Array.from({ length: maxW - 1 }, (_, i) => (
              <line x1={i + 1} y1="0" x2={i + 1} y2={maxD} class="tier__grid" vector-effect="non-scaling-stroke" />
            ))}
            {Array.from({ length: maxD - 1 }, (_, i) => (
              <line x1="0" y1={i + 1} x2={maxW} y2={i + 1} class="tier__grid" vector-effect="non-scaling-stroke" />
            ))}
            <rect x="0" y="0" width={maxW} height={maxD} class="tier__lot" vector-effect="non-scaling-stroke" />
            <rect x="0" y={maxD - t.depth} width={t.width} height={t.depth} class="tier__area" vector-effect="non-scaling-stroke" />
          </svg>
          <figcaption class="tier__size">
            <span class="tier__dims">{t.width} × {t.depth} m</span>
            <span class="tier__m2">{m2(t.width * t.depth)} m²</span>
          </figcaption>
        </figure>

        <p class="tier__pitch">{t.pitch}</p>
        <ul class="tier__features">
          {t.features.map((f) => (
            <li><span class="facet" aria-hidden="true"></span>{f}</li>
          ))}
        </ul>

        <div class="tier__foot">
          <p class="tier__price">
            <span class="tier__price-label">Investimento</span>
            <span class="tier__price-value">{t.price ?? 'Sob consulta'}</span>
          </p>
          <a
            class={`btn ${t.recommended ? '' : 'btn--ghost'} tier__cta`}
            href={waMessage(`Olá! Tenho interesse no stand ${t.name} (${t.width} × ${t.depth} m) do ${event.name}, ${event.edition}. Pode me enviar a proposta?`)}
            target="_blank"
            rel="noopener"
            aria-label={`Reservar stand ${t.name}, falar no WhatsApp (abre em nova aba)`}
          >
            <span>Reservar</span><span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>

  <p class="tiers__fine" data-reveal>
    <span class="facet" aria-hidden="true"></span>
    <span>Plantas em escala comparativa. {planos.fine}</span>
  </p>
</Pagina>

<style>
  .tiers {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.2rem, 2.2vw, 2rem);
    margin-top: clamp(2.6rem, 6vh, 4rem); align-items: stretch;
  }
  .tier {
    position: relative; padding: clamp(1.8rem, 3vw, 2.6rem);
    border: 1px solid var(--line); background: var(--bg-1);
    display: flex; flex-direction: column;
    transition: border-color var(--dur-fast), transform var(--dur-mid) var(--ease-expo);
  }
  .tier.is-featured {
    border-color: var(--gold);
    background: linear-gradient(155deg, rgba(198,161,91,0.11), rgba(198,161,91,0.03) 55%, var(--bg-1));
  }
  /* halo pre-rendered on ::after; hover only fades it (no animated box-shadow) */
  .tier.is-featured::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    box-shadow: 0 28px 70px -44px rgba(198,161,91,0.55);
    opacity: 0.85; transition: opacity var(--dur-mid) var(--ease-expo);
  }
  @media (hover: hover) {
    .tier:hover { transform: translateY(-5px); border-color: var(--line-strong); }
    .tier.is-featured:hover { border-color: var(--gold); }
    .tier.is-featured:hover::after { opacity: 1; }
  }
  .tier__badge {
    position: absolute; top: -1px; right: 1.5rem; transform: translateY(-50%);
    font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
    background: var(--gold-grad); color: #1a1407; padding: 0.5em 1.05em; font-weight: 700;
  }
  .tier__kicker { font-size: 0.7rem; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--gold); }
  .tier__name { font-size: var(--fs-h3); margin-top: 0.4rem; }
  .tier.is-featured .tier__name {
    background: var(--gold-grad); -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  .tier__plan { margin: 1.5rem 0 0; }
  .tier__plan svg { width: 100%; height: auto; overflow: visible; }
  .tier__grid { stroke: var(--line); stroke-width: 1; }
  .tier__lot { fill: var(--tint); stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 4 4; }
  .tier__area { fill: rgba(198,161,91,0.16); stroke: var(--gold); stroke-width: 1.5; }
  .tier.is-featured .tier__area { fill: rgba(198,161,91,0.26); }
  .tier__size {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    margin-top: 0.9rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--line);
  }
  .tier__dims { font-size: 0.85rem; letter-spacing: 0.1em; color: var(--text-muted); }  /* no caps: "m" is the unit */
  .tier__m2 { font-family: var(--font-display); font-weight: 500; font-size: 1.5rem; letter-spacing: -0.02em; color: var(--gold-bright); }

  .tier__pitch { margin: 1.2rem 0 1.5rem; color: var(--text); line-height: 1.5; }
  .tier__features { display: grid; gap: 0.8rem; margin-bottom: 2rem; flex: 1; align-content: start; }
  .tier__features li { display: flex; align-items: baseline; gap: 0.85rem; color: var(--text-muted); font-size: 0.95rem; line-height: 1.45; }
  .tier__features .facet { flex: none; color: var(--gold); width: 0.5em; height: 0.5em; }

  .tier__foot { display: grid; gap: 1.2rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .tier__price { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .tier__price-label { font-size: 0.7rem; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--text-dim); }
  .tier__price-value { font-family: var(--font-display); font-weight: 500; font-size: 1.15rem; color: var(--text-strong); }
  .tier__cta { width: 100%; justify-content: center; }

  .tiers__fine {
    display: flex; align-items: center; justify-content: center; gap: 0.7rem; flex-wrap: wrap;
    margin-top: clamp(2rem, 4vw, 3rem); text-align: center;
    font-size: 0.85rem; color: var(--text-dim); letter-spacing: 0.02em;
  }
  .tiers__fine .facet { color: var(--gold); flex: none; }

  @media (max-width: 1024px) {
    .tiers { grid-template-columns: 1fr; max-width: 34rem; gap: 2.2rem; }
  }
</style>
