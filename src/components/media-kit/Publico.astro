---
import { Image } from 'astro:assets';
import networking from '../../assets/images/members-networking.jpg';
import { publico } from '../../data/media-kit';
---
<section class="mk-pub section grain" id="publico">
  <div class="mk-pub__bg" aria-hidden="true">
    <div class="mk-pub__bg-inner" data-parallax="0.06">
      <Image src={networking} alt="" class="media-cover" widths={[768, 1280, 1920]} sizes="100vw" quality={70} loading="lazy" />
    </div>
  </div>
  <div class="mk-pub__glow" aria-hidden="true"></div>

  <div class="container container--wide">
    <div class="mk-pub__head">
      <p class="eyebrow" data-reveal="fade">{publico.eyebrow}</p>
      <h2 class="mk-pub__title" data-reveal data-split>{publico.title}</h2>
      <p class="mk-pub__lead lead" data-reveal style="--reveal-delay:120ms">{publico.lead}</p>
    </div>

    <div class="mk-pub__grid" data-stagger="110">
      {publico.profiles.map((p, i) => (
        <article class="mk-pub__card">
          <span class="index-num">0{i + 1}</span>
          <h3 class="mk-pub__name">{p.title}</h3>
          <p class="mk-pub__body">{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .mk-pub { position: relative; overflow: clip; }
  .mk-pub__bg { position: absolute; inset: 0; z-index: 0; overflow: clip; }
  .mk-pub__bg-inner { position: absolute; inset: -10% 0; will-change: transform; }
  .mk-pub__bg::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(6,14,11,1) 0%, rgba(6,14,11,0.80) 22%, rgba(6,14,11,0.82) 60%, rgba(6,14,11,1) 100%),
      linear-gradient(90deg, rgba(6,14,11,0.85) 0%, rgba(6,14,11,0.40) 70%);
  }
  .mk-pub__glow {
    position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background: radial-gradient(50% 60% at 86% 20%, rgba(43,124,94,0.16), transparent 62%);
  }
  .mk-pub .container { position: relative; z-index: 1; }

  .mk-pub__head { max-width: 40ch; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .mk-pub__title { font-size: var(--fs-h2); margin-top: 1.4rem; line-height: 1.05; }
  .mk-pub__lead { margin-top: 1.4rem; color: var(--text-muted); }

  .mk-pub__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2vw, 1.6rem); }
  .mk-pub__card {
    padding: clamp(1.6rem, 2.6vw, 2.2rem);
    border: 1px solid var(--line); background: rgba(8,21,17,0.62);
    transition: border-color var(--dur-fast), background var(--dur-fast), transform var(--dur-mid) var(--ease-expo);
  }
  @media (hover: hover) {
    .mk-pub__card:hover { border-color: var(--line-gold); background: rgba(15,41,32,0.7); transform: translateY(-4px); }
  }
  .mk-pub__name { font-size: var(--fs-h4); margin: 1.2rem 0 0.8rem; }
  .mk-pub__body { color: var(--text-muted); line-height: 1.55; font-size: 0.98rem; }

  @media (max-width: 1180px) {
    .mk-pub__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .mk-pub__grid { grid-template-columns: 1fr; }
  }
</style>
