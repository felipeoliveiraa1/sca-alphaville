---
import { stands, event, waMessage } from '../../data/media-kit';

// Floor plans share one scale: every footprint is drawn inside the largest stand's grid.
const maxW = Math.max(...stands.tiers.map((t) => t.width));
const maxD = Math.max(...stands.tiers.map((t) => t.depth));
const m2 = (n: number) => n.toLocaleString('pt-BR');
---
<section class="mk-stands section" id="stands">
  <div class="mk-stands__glow" aria-hidden="true"></div>
  <div class="container container--wide">
    <div class="mk-stands__head">
      <div>
        <p class="eyebrow" data-reveal="fade">{stands.eyebrow}</p>
        <h2 class="mk-stands__title" data-reveal data-split>{stands.title}</h2>
      </div>
      <p class="mk-stands__lead lead" data-reveal style="--reveal-delay:120ms">{stands.lead}</p>
    </div>

    <ul class="mk-stands__benefits" data-stagger="100">
      {stands.benefits.map((b) => (
        <li class="mk-stands__benefit">
          <span class="facet" aria-hidden="true"></span>
          <div>
            <h3 class="mk-stands__bname">{b.title}</h3>
            <p class="mk-stands__bbody">{b.body}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mk-stands__tiers" data-stagger="140">
      {stands.tiers.map((t) => (
        <article class={`mk-tier ${t.recommended ? 'is-featured' : ''}`}>
          {t.recommended && <span class="mk-tier__badge">Recomendado</span>}
          <h3 class="mk-tier__name">{t.name}</h3>

          <figure class="mk-tier__plan">
            <svg viewBox={`0 0 ${maxW} ${maxD}`} aria-hidden="true" focusable="false">
              {Array.from({ length: maxW - 1 }, (_, i) => (
                <line x1={i + 1} y1="0" x2={i + 1} y2={maxD} class="mk-tier__grid" vector-effect="non-scaling-stroke" />
              ))}
              {Array.from({ length: maxD - 1 }, (_, i) => (
                <line x1="0" y1={i + 1} x2={maxW} y2={i + 1} class="mk-tier__grid" vector-effect="non-scaling-stroke" />
              ))}
              <rect x="0" y="0" width={maxW} height={maxD} class="mk-tier__lot" vector-effect="non-scaling-stroke" />
              <rect x="0" y={maxD - t.depth} width={t.width} height={t.depth} class="mk-tier__area" vector-effect="non-scaling-stroke" />
            </svg>
            <figcaption class="mk-tier__size">
              <span class="mk-tier__dims">{t.width} × {t.depth} m</span>
              <span class="mk-tier__m2">{m2(t.width * t.depth)} m²</span>
            </figcaption>
          </figure>

          <p class="mk-tier__pitch">{t.pitch}</p>
          <ul class="mk-tier__features">
            {t.features.map((f) => (
              <li><span class="facet" aria-hidden="true"></span>{f}</li>
            ))}
          </ul>

          <div class="mk-tier__foot">
            <p class="mk-tier__price">
              <span class="mk-tier__price-label">Investimento</span>
              <span class="mk-tier__price-value">{t.price ?? 'Sob consulta'}</span>
            </p>
            <a
              class={`btn ${t.recommended ? '' : 'btn--ghost'} mk-tier__cta`}
              href={waMessage(`Olá! Tenho interesse no stand ${t.name} (${t.width} × ${t.depth} m) do ${event.name} ${event.edition}. Pode me enviar a proposta?`)}
              target="_blank"
              rel="noopener"
              aria-label={`Reservar stand ${t.name}, falar no WhatsApp (abre em nova aba)`}
            >
              <span>Reservar</span><span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="mk-stands__fine" data-reveal>
      <span class="facet" aria-hidden="true"></span>
      <span>Plantas em escala comparativa. {stands.fine}</span>
    </p>
  </div>
</section>

<style>
  .mk-stands { position: relative; overflow: clip; }
  .mk-stands__glow {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(55% 40% at 50% 62%, rgba(43,124,94,0.14), transparent 70%),
      radial-gradient(40% 30% at 85% 10%, rgba(198,161,91,0.06), transparent 70%);
  }
  .mk-stands .container { position: relative; }

  .mk-stands__head {
    display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(2rem, 5vw, 5rem); align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .mk-stands__title { font-size: var(--fs-h2); margin-top: 1.4rem; line-height: 1.05; max-width: 14ch; }
  .mk-stands__lead { color: var(--text-muted); }

  /* Why exhibit: a quiet three-up rail */
  .mk-stands__benefits {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 3vw, 3rem);
    padding-block: clamp(1.8rem, 3.5vw, 2.6rem);
    border-block: 1px solid var(--line);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .mk-stands__benefit { display: flex; gap: 1rem; align-items: flex-start; }
  .mk-stands__benefit .facet { flex: none; color: var(--gold); margin-top: 0.45rem; }
  .mk-stands__bname { font-size: 1.1rem; letter-spacing: -0.01em; }
  .mk-stands__bbody { margin-top: 0.45rem; color: var(--text-muted); font-size: 0.95rem; line-height: 1.55; }

  /* ---- Tier cards ---- */
  .mk-stands__tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.2rem, 2.2vw, 2rem); align-items: stretch; }
  .mk-tier {
    position: relative; padding: clamp(1.8rem, 3vw, 2.6rem);
    border: 1px solid var(--line); background: var(--bg-1);
    display: flex; flex-direction: column;
    transition: border-color var(--dur-fast), transform var(--dur-mid) var(--ease-expo);
  }
  .mk-tier.is-featured {
    border-color: var(--gold);
    background: linear-gradient(155deg, rgba(198,161,91,0.11), rgba(198,161,91,0.03) 55%, var(--bg-1));
  }
  /* halo pre-rendered on ::after; hover only fades it (no animated box-shadow) */
  .mk-tier.is-featured::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    box-shadow: 0 28px 70px -44px rgba(198,161,91,0.55);
    opacity: 0.85; transition: opacity var(--dur-mid) var(--ease-expo);
  }
  @media (hover: hover) {
    .mk-tier:hover { transform: translateY(-5px); border-color: var(--line-strong); }
    .mk-tier.is-featured:hover { border-color: var(--gold); }
    .mk-tier.is-featured:hover::after { opacity: 1; }
  }
  .mk-tier__badge {
    position: absolute; top: -1px; right: 1.5rem; transform: translateY(-50%);
    font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
    background: var(--gold-grad); color: #1a1407; padding: 0.5em 1.05em; font-weight: 700;
  }
  .mk-tier__name { font-size: var(--fs-h3); }

  .mk-tier__plan { margin: 1.6rem 0 0; }
  .mk-tier__plan svg { width: 100%; height: auto; overflow: visible; }
  .mk-tier__grid { stroke: var(--line); stroke-width: 1; }
  .mk-tier__lot { fill: var(--tint); stroke: var(--line-strong); stroke-width: 1; stroke-dasharray: 4 4; }
  .mk-tier__area { fill: rgba(198,161,91,0.16); stroke: var(--gold); stroke-width: 1.5; }
  .mk-tier.is-featured .mk-tier__area { fill: rgba(198,161,91,0.26); }
  .mk-tier__size {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    margin-top: 0.9rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--line);
  }
  .mk-tier__dims { font-size: 0.85rem; letter-spacing: 0.1em; color: var(--text-muted); }  /* no caps: "m" is the unit */
  .mk-tier__m2 { font-family: var(--font-display); font-weight: 500; font-size: 1.5rem; letter-spacing: -0.02em; color: var(--gold-bright); }

  .mk-tier__pitch { margin: 1.2rem 0 1.5rem; color: var(--text); line-height: 1.5; }
  .mk-tier__features { display: grid; gap: 0.8rem; margin-bottom: 2rem; flex: 1; align-content: start; }
  .mk-tier__features li { display: flex; align-items: baseline; gap: 0.85rem; color: var(--text-muted); font-size: 0.95rem; line-height: 1.45; }
  .mk-tier__features .facet { flex: none; color: var(--gold); width: 0.5em; height: 0.5em; transform: rotate(45deg) translateY(-0.1em); }

  .mk-tier__foot { display: grid; gap: 1.2rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .mk-tier__price { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .mk-tier__price-label { font-size: 0.7rem; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--text-dim); }
  .mk-tier__price-value { font-family: var(--font-display); font-weight: 500; font-size: 1.15rem; color: var(--text-strong); }
  .mk-tier__cta { width: 100%; justify-content: center; }

  .mk-stands__fine {
    display: flex; align-items: center; justify-content: center; gap: 0.7rem; flex-wrap: wrap;
    margin-top: clamp(2rem, 4vw, 3rem); text-align: center;
    font-size: 0.85rem; color: var(--text-dim); letter-spacing: 0.02em;
  }
  .mk-stands__fine .facet { color: var(--gold); flex: none; }

  @media (max-width: 1024px) {
    .mk-stands__tiers { grid-template-columns: 1fr; max-width: 34rem; margin-inline: auto; gap: 2.2rem; }
  }
  @media (max-width: 860px) {
    .mk-stands__head { grid-template-columns: 1fr; gap: 1.4rem; }
    .mk-stands__benefits { grid-template-columns: 1fr; gap: 1.4rem; }
  }
</style>
